{
  "_note": "一级科目归一表。只做「账里的写法 → 系统标准一级科目」的映射，不含后缀逻辑、不含科目组合逻辑。\n流程：读原始一级科目 → 按分隔符剥后缀（subject_norm.split_suffix）→ 查本表 → 得到标准科目 → 再拼科目组合。\n维护：跑 _dev/scripts/list_unknown_subjects.py 列出模型不认识的科目（已按频次排序），加一条 match 即可，不用重训。\nmatch 用 * 通配（如 \"*银行*\" 匹配 中行2908、广发银行0178）；不带 * 的是精确匹配。规则自上而下，命中第一条即返回。",
  "rules": [
    {
      "_note": "税费：增值税/个税相关全部归到应交税费",
      "match": [
        "应交税金",
        "应缴税费",
        "应交增值税",
        "应交增值税费",
        "增值税",
        "进项税额",
        "进项税",
        "销项税额",
        "销项税",
        "进项税额转出",
        "待抵扣进项税额",
        "待认证进项税额",
        "未交增值税",
        "转出未交增值税",
        "已开票销项税",
        "应交个人所得税",
        "个人所得税"
      ],
      "to": "应交税费"
    },
    {
      "_note": "生产成本的两个细分",
      "match": [
        "基本生产成本",
        "辅助生产成本"
      ],
      "to": "生产成本"
    },
    {
      "_note": "工资与社保：都属应付职工薪酬（成本中心不改变经济业务性质）",
      "match": [
        "生产工资",
        "应付工资",
        "职工薪酬",
        "社会保险费",
        "社保",
        "养老保险",
        "医疗保险",
        "失业保险",
        "工伤保险",
        "生育保险",
        "住房公积金"
      ],
      "to": "应付职工薪酬"
    },
    {
      "_note": "制造费用的错写/别写",
      "match": [
        "制造费费",
        "制造费",
        "制造费转入",
        "制造费用转入"
      ],
      "to": "制造费用"
    },
    {
      "_note": "附加税费：二级科目归到税金及附加",
      "match": [
        "主营业务税金及附加",
        "营业税金及附加",
        "印花税",
        "地方教育费附加",
        "应交地方教育费附加",
        "教育费附加",
        "城市维护建设税",
        "城建税"
      ],
      "to": "税金及附加"
    },
    {
      "_note": "票据类：应收款项融资/银承/商承 都是应收票据口径",
      "match": [
        "应收款项融资",
        "银行承兑汇票",
        "银行承兑",
        "银承",
        "商承",
        "应收出口退税"
      ],
      "to": "应收票据"
    },
    {
      "_note": "银行账户名当一级科目用（中行2908、广发银行0178、频信广发行…）。匹配的是剥完后缀的一级科目名，所以不会误伤「其他应付款—广发」",
      "match": [
        "*银行*",
        "*中行*",
        "*招行*",
        "*工行*",
        "*建行*",
        "*农行*",
        "*交行*",
        "*农商行*",
        "*广发*",
        "*浦发*",
        "*兴业*",
        "*民生*",
        "*中信*",
        "*华夏*",
        "*光大*",
        "*邮储*",
        "*招商*"
      ],
      "to": "银行存款"
    },
    {
      "_note": "备用金/现金户",
      "match": [
        "现金",
        "备用金",
        "库存现金"
      ],
      "to": "库存现金"
    },
    {
      "match": [
        "辅料",
        "辅料及包装物"
      ],
      "to": "原材料"
    },
    {
      "match": [
        "其他业务成本"
      ],
      "to": "其他业务支出"
    },
    {
      "match": [
        "所得税"
      ],
      "to": "所得税费用"
    },
    {
      "match": [
        "待摊费用"
      ],
      "to": "长期待摊费用"
    },
    {
      "match": [
        "预提费用"
      ],
      "to": "预计负债"
    },
    {
      "match": [
        "商品销售收入"
      ],
      "to": "主营业务收入"
    },
    {
      "match": [
        "商品销售成本"
      ],
      "to": "主营业务成本"
    },
    {
      "match": [
        "补贴收入",
        "政府补贴"
      ],
      "to": "其他收益"
    },
    {
      "_note": "期初建账的中转科目，本质是以前年度损益调整",
      "match": [
        "期初中转科目"
      ],
      "to": "以前年度损益调整"
    }
  ]
}